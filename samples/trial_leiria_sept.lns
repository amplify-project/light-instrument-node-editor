    {
      "id": "annotation-1785958851640",
      "type": "annotation",
      "position": {
        "x": 445.69353394662016,
        "y": -414.2796779774879
      },
      "data": {
        "label": "Annotation",
        "text": "This area of the node tree filters for messages from the key instrument. Every time a button press (i.e. the data value is equal to one) is received on any key it is add to a counter. We then perform an integer division of the counter value by 3. Then:\n\n- If the resulting remainder is equal to 0, we send a 'pulse' command with colour red to the strip named LED3\n- If the resulting remainder is equal to 1, we send a 'pulse' command with colour green to the strip named LED3\n- If the resulting remainder is euqal to 2, we send a 'pulse' command with\ncolour blue to the strip named LED3"
      },
      "zIndex": -1,
      "width": 528,
      "height": 259,
      "measured": {
        "width": 528,
        "height": 259
      },
      "selected": false,
      "dragging": false,
      "resizing": false
    },
    {
      "id": "annotation-1785959344588",
      "type": "annotation",
      "position": {
        "x": 464.14474661215354,
        "y": 794.045061500302
      },
      "data": {
        "label": "Annotation",
        "text": "This area of the tree filters for messages from the instrument named 'drum_big'. We then take the derivative of the signal, which will have a positive value if the signal increases and a negative value if the value decreases. This is passed into a rising edge trigger, which will emit a signal every time the signal is on the increase and has a value greater than 100. Every time the trigger activates, a red 'pulse' command is sent to all LED strips on all LED controllers."
      },
      "zIndex": -1,
      "width": 723,
      "height": 160,
      "measured": {
        "width": 723,
        "height": 160
      },
      "selected": false,
      "dragging": false,
      "resizing": false
    },
    {
      "id": "annotation-1785960010648",
      "type": "annotation",
      "position": {
        "x": 1107.3435489159024,
        "y": 1610.9063150063369
      },
      "data": {
        "label": "Annotation",
        "text": "This area filters for the maracas. If a signal on 'maracas1' is detected, send a green 'pulse' command to all output devices. If a signal on 'maracas2' is detected, send a blue 'pulse' command to all output devices"
      },
      "zIndex": -1,
      "width": 271,
      "height": 215,
      "measured": {
        "width": 271,
        "height": 215
      },
      "selected": false,
      "dragging": false,
      "resizing": false
    },
    {
      "id": "annotation-1785960172586",
      "type": "annotation",
      "position": {
        "x": 1595.5713909913293,
        "y": 1418.6483150157958
      },
      "data": {
        "label": "Annotation",
        "text": "This area filters for the different ports of the 'touch' instrument:\n\n- If a touch on the port named 'r' is detected, a 'comet' animation withe the colours red is triggered\n- If a touch on the port named 'g' is detected, a 'comet' animation withe the colours green is triggered\n- If a touch on the port named 'b' is detected, a 'comet' animation withe the colours blue is triggered\n"
      },
      "zIndex": -1,
      "width": 472,
      "height": 195,
      "measured": {
        "width": 472,
        "height": 195
      },
      "selected": false,
      "dragging": false,
      "resizing": false
    },
